{
  "visualization": {
    "id": "custom_radar_chart",
    "label": "Custom Radar Chart",
    "description": "Radar chart built with Chart.js",
    "resources": [
      {
        "type": "js",
        "url": "index.js"
      },
      {
        "type": "html",
        "url": "index.html"
      }
    ]
  },
  "options": {
    "showLegend": {
      "label": "凡例を表示する",
      "type": "BOOLEAN",
      "default": true
    },
    "scaleMin": {
      "label": "スケール最小値",
      "type": "NUMBER",
      "default": 0
    },
    "scaleMax": {
      "label": "スケール最大値",
      "type": "NUMBER",
      "default": 5
    }
  }
}
